{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "REDIS_URL",
        "JWT_PRIVATE_KEY_BASE64",
        "JWT_PUBLIC_KEY_BASE64",
        "JWT_ACCESS_TOKEN_TTL_SECONDS",
        "REFRESH_TOKEN_TTL_DAYS",
        "TWO_FA_ENCRYPTION_KEY_BASE64",
        "PAYMENT_CREDENTIAL_ENCRYPTION_KEY_BASE64",
        "ACCOUNTING_TOKEN_ENCRYPTION_KEY_BASE64",
        "QUICKBOOKS_CLIENT_ID",
        "QUICKBOOKS_CLIENT_SECRET",
        "QUICKBOOKS_REDIRECT_URI",
        "XERO_CLIENT_ID",
        "XERO_CLIENT_SECRET",
        "XERO_REDIRECT_URI",
        "PAYSTACK_SECRET_KEY",
        "MONO_SECRET_KEY",
        "ANTHROPIC_API_KEY",
        "TERMII_API_KEY",
        "TERMII_SENDER_ID",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "WEB_APP_URL"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "APP_DATABASE_URL",
        "REDIS_URL",
        "JWT_PRIVATE_KEY_BASE64",
        "JWT_PUBLIC_KEY_BASE64",
        "JWT_ACCESS_TOKEN_TTL_SECONDS",
        "REFRESH_TOKEN_TTL_DAYS",
        "TWO_FA_ENCRYPTION_KEY_BASE64",
        "PAYMENT_CREDENTIAL_ENCRYPTION_KEY_BASE64",
        "ACCOUNTING_TOKEN_ENCRYPTION_KEY_BASE64",
        "QUICKBOOKS_CLIENT_ID",
        "QUICKBOOKS_CLIENT_SECRET",
        "QUICKBOOKS_REDIRECT_URI",
        "XERO_CLIENT_ID",
        "XERO_CLIENT_SECRET",
        "XERO_REDIRECT_URI",
        "PAYSTACK_SECRET_KEY",
        "MONO_SECRET_KEY",
        "ANTHROPIC_API_KEY",
        "TERMII_API_KEY",
        "TERMII_SENDER_ID",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "WEB_APP_URL"
      ]
    }
  }
}
