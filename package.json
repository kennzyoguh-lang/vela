{
  "name": "vela",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare": "husky",
    "db:generate": "pnpm --filter @vela/api db:generate",
    "db:migrate": "pnpm --filter @vela/api db:migrate",
    "db:setup": "pnpm --filter @vela/api db:setup",
    "verify:rls": "node scripts/verify-rls.mjs",
    "lint:sql": "node scripts/lint-sql.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "nanoid@<3.3.18": ">=3.3.18",
      "qs@<6.16.0": ">=6.16.0",
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<6.4.3": ">=6.4.3",
      "fast-uri@<3.1.6": ">=3.1.6",
      "brace-expansion@<5.0.9": ">=5.0.9",
      "js-yaml@<4.3.2": ">=4.3.2"
    }
  }
}
