// VELA — Foundation schema. Module-owned tables (invoices, employees, transactions,
// compliance_obligations, ...) are added when their module ships (Handbook Part 6.2/6.8).
// RLS policies are NOT expressed here — Prisma has no RLS primitive — they are
// hand-authored SQL added via `prisma migrate dev --create-only` immediately after
// each migration that introduces an org_id-scoped table (see prisma/migrations/
// and scripts/verify-rls.mjs, which fails CI if one is missing).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  accountant
  staff
  view_only

  @@map("role")
}

enum SubscriptionTier {
  starter
  growth
  enterprise
  corporate

  @@map("subscription_tier")
}

model Organisation {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  industry           String?
  baseCurrency       String           @default("NGN") @map("base_currency") @db.Char(3)
  country            String           @default("NG")
  registrationNumber String?          @map("registration_number")
  taxId              String?          @map("tax_id")
  subscriptionTier   SubscriptionTier @default(starter) @map("subscription_tier")
  subscriptionStatus String           @default("trialing") @map("subscription_status")
  ownerId            String?          @map("owner_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users                 User[]
  sessions              UserSession[]
  invites               OrganisationInvite[]
  clients               Client[]
  invoices              Invoice[]
  recurringInvoices     RecurringInvoice[]
  transactionMarkups    TransactionMarkup[]
  paymentActivation     PaymentActivation?
  complianceObligations OrgComplianceObligation[]
  complianceFilings     ComplianceFiling[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  employees             Employee[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  accountantLinks       AccountantClientLink[]
  askVelaConversations  AskVelaConversation[]
  askVelaMessages       AskVelaMessage[]

  @@map("organisations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  name            String
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  role            Role      @default(staff)
  // Reversible (AES-256-GCM), not hashed — TOTP verification requires the
  // original secret to recompute the expected code, which a one-way hash
  // structurally can never provide. See twofa.service.ts encrypt/decrypt.
  twoFaSecretEncrypted String? @map("two_fa_secret_encrypted")
  twoFaEnabled    Boolean   @default(false) @map("two_fa_enabled")
  backupCodesHash String[]  @map("backup_codes_hash")
  lastLogin       DateTime? @map("last_login") @db.Timestamptz
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation         Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions             UserSession[]
  accountantLinks      AccountantClientLink[]
  askVelaConversations AskVelaConversation[]

  @@index([orgId])
  @@map("users")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  sessionFamilyId  String   @map("session_family_id") @db.Uuid
  deviceInfo       String?  @map("device_info")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastActive       DateTime @default(now()) @map("last_active") @db.Timestamptz
  isActive         Boolean  @default(true) @map("is_active")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@map("user_sessions")
}

model OrganisationInvite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  email     String   @db.Citext
  role      Role     @default(staff)
  status    String   @default("pending")
  invitedBy String   @map("invited_by") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("organisation_invites")
}

// === SmartInvoice™ (Phase 2, BRD Module 1 / Handbook Part 16.1) ===

enum InvoiceStatus {
  draft
  sent
  viewed
  partially_paid
  paid
  overdue
  written_off
  void

  @@map("invoice_status")
}

enum RecurringFrequency {
  weekly
  monthly
  quarterly

  @@map("recurring_frequency")
}

enum PaymentProcessor {
  paystack
  flutterwave
  stripe

  @@map("payment_processor")
}

model Client {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  paymentTerms   Int      @default(14) @map("payment_terms") // net days
  avgPaymentDays Float?   @map("avg_payment_days") // recalculated from paid invoice history
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation      Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@index([orgId])
  @@map("clients")
}

// Invoice numbering (INV-<sequential>) is per-org and generated inside the
// same transaction as creation (invoice.repository.ts) — this counter table
// avoids a race between two concurrent invoice creations in the same org.
model InvoiceNumberCounter {
  orgId String @id @map("org_id") @db.Uuid
  next  Int    @default(1)

  @@map("invoice_number_counters")
}

model Invoice {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  number             String // "INV-0001", unique per org (see @@unique below)
  clientId           String        @map("client_id") @db.Uuid
  lineItems          Json          @map("line_items")
  subtotal           Decimal       @db.Decimal(14, 2)
  tax                Decimal       @default(0) @db.Decimal(14, 2)
  discount           Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  currency           String        @default("NGN") @db.Char(3)
  status             InvoiceStatus @default(draft)
  dueDate            DateTime      @map("due_date") @db.Date
  riskScore          Int?          @map("risk_score") // 0-100, null until first scored (Epic 3)
  paymentPortalToken String        @unique @map("payment_portal_token")
  notes              String?
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz
  viewedAt           DateTime?     @map("viewed_at") @db.Timestamptz
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz
  voidedReason       String?       @map("voided_reason")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation       Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id])
  transactionMarkups TransactionMarkup[]

  @@unique([orgId, number])
  @@index([orgId, status, dueDate])
  @@map("invoices")
}

model RecurringInvoice {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  clientId     String             @map("client_id") @db.Uuid
  frequency    RecurringFrequency
  nextSendDate DateTime           @map("next_send_date") @db.Date
  templateData Json               @map("template_data")
  status       String             @default("active") // active | paused | cancelled
  lastSentAt   DateTime?          @map("last_sent_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])

  @@index([orgId, status, nextSendDate])
  @@map("recurring_invoices")
}

// F-72: recorded as a distinct line, never blended into the processor's own
// fee (BRD's explicit requirement) — one row per settled payment.
model TransactionMarkup {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  invoiceId     String           @map("invoice_id") @db.Uuid
  processor     PaymentProcessor
  grossAmount   Decimal          @map("gross_amount") @db.Decimal(14, 2)
  processorFee  Decimal          @map("processor_fee") @db.Decimal(14, 2)
  velaMarkupPct Decimal          @map("vela_markup_pct") @db.Decimal(5, 4) // e.g. 0.0100 = 1.00%
  velaFeeAmount Decimal          @map("vela_fee_amount") @db.Decimal(14, 2)
  currency      String           @db.Char(3)
  settledAt     DateTime         @map("settled_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  @@index([orgId, settledAt])
  @@map("transaction_markups")
}

// BRD v3.1 Section 6.3 — tracks per-org Pay Now adoption; F-73's nudge logic
// (deferred to the P&L Intelligence phase) will read this, but the table
// itself is populated starting now by the webhook handler (Epic 5).
model PaymentActivation {
  orgId                  String    @id @map("org_id") @db.Uuid
  payNowEnabledAt        DateTime? @map("pay_now_enabled_at") @db.Timestamptz
  firstPaymentReceivedAt DateTime? @map("first_payment_received_at") @db.Timestamptz
  activationChannel      String?   @map("activation_channel") // whatsapp_link | portal
  cumulativeVolumeNgn    Decimal   @default(0) @map("cumulative_volume_ngn") @db.Decimal(16, 2)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("payment_activations")
}

// Handbook 5.9: idempotent against replay via the provider's event ID —
// every webhook handler checks this table before processing, regardless of
// provider.
model WebhookEvent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processor       PaymentProcessor
  providerEventId String           @map("provider_event_id")
  receivedAt      DateTime         @default(now()) @map("received_at") @db.Timestamptz

  @@unique([processor, providerEventId])
  @@map("webhook_events")
}

// Write-once — REVOKE UPDATE/DELETE + immutability trigger applied via raw SQL
// migration (Handbook 6.4). org_id is intentionally NOT a foreign key with cascade
// delete, so an org deletion (data export + closure) can never take audit history
// with it (Handbook 6.9).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// === ComplianceRadar™ (Phase 3) ===
// Scope: six MUST obligation types, Nigeria-only, no e-filing API integration
// (see the Phase 3 plan) — filing status is derived (compliance.service.ts's
// computeFilingStatus), never stored, same "derive don't store" approach as
// invoice-risk.service.ts's risk band.

enum ComplianceObligationType {
  vat
  paye
  pension
  wht
  cit
  cac_annual_return

  @@map("compliance_obligation_type")
}

// Frequency ("monthly"/"annual") is pure application metadata — read from
// compliance-obligation-rules.ts's OBLIGATION_RULES, never stored on a row —
// so it's a plain TypeScript type there, not a Postgres enum/column here.

// Which obligation types a given org has switched on (Settings page toggle) —
// a filing is only ever generated for an active obligation.
model OrgComplianceObligation {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String                   @map("org_id") @db.Uuid
  obligationType ComplianceObligationType @map("obligation_type")
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, obligationType])
  @@map("org_compliance_obligations")
}

// One row per due period (e.g. "2026-08" for a monthly VAT filing, "FY2026"
// for CAC's annual return). The @@unique constraint is what makes the daily
// generator job idempotent — it upserts, never duplicates, a period's row.
model ComplianceFiling {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String                   @map("org_id") @db.Uuid
  obligationType   ComplianceObligationType @map("obligation_type")
  periodLabel      String                   @map("period_label")
  dueDate          DateTime                 @map("due_date") @db.Date
  filedAt          DateTime?                @map("filed_at") @db.Timestamptz
  receiptReference String?                  @map("receipt_reference")
  notes            String?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, obligationType, periodLabel])
  @@index([orgId, dueDate])
  @@map("compliance_filings")
}

// === P&L Intelligence (Phase 4) ===
// Scope: Mono bank sync (Okra as an unwired second provider, same pattern as
// SmartInvoice's payment gateways), rule-based categorization not ML, daily
// polling sync not real-time webhooks, NGN-only, no cross-module
// reconciliation against invoices/filings (see the Phase 4 plan).

enum BankSyncProvider {
  mono
  okra

  @@map("bank_sync_provider")
}

enum TransactionType {
  credit
  debit

  @@map("transaction_type")
}

enum TransactionCategory {
  income
  cost_of_goods
  payroll
  rent
  utilities
  marketing
  transport
  other_expense
  transfer
  uncategorized

  @@map("transaction_category")
}

model BankAccount {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String           @map("org_id") @db.Uuid
  provider            BankSyncProvider
  providerAccountId   String           @map("provider_account_id")
  institutionName     String           @map("institution_name")
  accountType         String           @map("account_type")
  accountNumberMasked String           @map("account_number_masked")
  currency            String           @default("NGN") @db.Char(3)
  currentBalance      Decimal          @default(0) @map("current_balance") @db.Decimal(14, 2)
  lastSyncedAt        DateTime?        @map("last_synced_at") @db.Timestamptz
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([orgId, provider, providerAccountId])
  @@map("bank_accounts")
}

// @@unique on [bankAccountId, providerTransactionId] is what makes the daily
// sync job idempotent — same upsert-by-external-id shape as webhook_events
// and compliance_filings.
model BankTransaction {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String              @map("org_id") @db.Uuid
  bankAccountId         String              @map("bank_account_id") @db.Uuid
  providerTransactionId String              @map("provider_transaction_id")
  type                  TransactionType
  amount                Decimal             @db.Decimal(14, 2)
  category              TransactionCategory @default(uncategorized)
  categorizedManually   Boolean             @default(false) @map("categorized_manually")
  narration             String
  transactionDate       DateTime            @map("transaction_date") @db.Date
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, providerTransactionId])
  @@index([orgId, transactionDate])
  @@map("bank_transactions")
}

// === PeopleHub (Phase 5) ===
// Scope: payroll calculation (PAYE/pension/NHF) and payslips, no salary
// disbursement, fixed (non-configurable) Nigerian PAYE bands and a flat 2.5%
// NHF rate — see the Phase 5 plan for the full list of deferrals.

enum EmploymentType {
  full_time
  part_time
  contract

  @@map("employment_type")
}

// Two states, not Invoice's eight — no external event drives a transition
// here, just the org marking payroll as actually paid.
enum PayrollRunStatus {
  draft
  paid

  @@map("payroll_run_status")
}

model Employee {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String         @map("org_id") @db.Uuid
  name               String
  email              String?
  jobTitle           String         @map("job_title")
  employmentType     EmploymentType @map("employment_type")
  basicSalary        Decimal        @map("basic_salary") @db.Decimal(14, 2)
  housingAllowance   Decimal        @default(0) @map("housing_allowance") @db.Decimal(14, 2)
  transportAllowance Decimal        @default(0) @map("transport_allowance") @db.Decimal(14, 2)
  otherAllowances    Decimal        @default(0) @map("other_allowances") @db.Decimal(14, 2)
  startDate          DateTime       @map("start_date") @db.Date
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@index([orgId])
  @@map("employees")
}

// @@unique on [orgId, periodLabel] means running payroll twice for the same
// month recomputes the existing draft rather than duplicating it
// (payroll.service.ts's runPayroll) — a paid run is immutable.
model PayrollRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  periodLabel     String           @map("period_label")
  status          PayrollRunStatus @default(draft)
  runDate         DateTime         @default(now()) @map("run_date") @db.Timestamptz
  totalGrossPay   Decimal          @default(0) @map("total_gross_pay") @db.Decimal(16, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(16, 2)
  totalNetPay     Decimal          @default(0) @map("total_net_pay") @db.Decimal(16, 2)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([orgId, periodLabel])
  @@index([orgId, periodLabel])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  payrollRunId    String   @map("payroll_run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  grossPay        Decimal  @map("gross_pay") @db.Decimal(14, 2)
  paye            Decimal  @db.Decimal(14, 2)
  employeePension Decimal  @map("employee_pension") @db.Decimal(14, 2)
  employerPension Decimal  @map("employer_pension") @db.Decimal(14, 2)
  nhf             Decimal  @db.Decimal(14, 2)
  netPay          Decimal  @map("net_pay") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

// === Accountant Portal (Phase 6) ===
// Scope: read-only summary dashboards, invite-by-email link model (mirrors
// OrganisationInvite), no cross-org RLS policy changes — an authorized read
// goes through the normal withOrgScope(clientOrgId, ...) path after an
// application-layer access check (see accountant-portal.service.ts). See the
// Phase 6 plan for what's deferred (export, per-module ACLs, firm entities).

enum AccountantLinkStatus {
  pending
  active
  revoked

  @@map("accountant_link_status")
}

// org_id here is the CLIENT org granting access — RLS scopes this table
// exactly like organisation_invites (a client org manages its own outgoing
// links), never as an exception for the accountant's own org.
model AccountantClientLink {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String               @map("org_id") @db.Uuid
  accountantEmail  String               @map("accountant_email") @db.Citext
  accountantUserId String?              @map("accountant_user_id") @db.Uuid
  status           AccountantLinkStatus @default(pending)
  invitedBy        String               @map("invited_by") @db.Uuid
  invitedAt        DateTime             @default(now()) @map("invited_at") @db.Timestamptz
  respondedAt      DateTime?            @map("responded_at") @db.Timestamptz
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz

  organisation   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accountantUser User?        @relation(fields: [accountantUserId], references: [id])

  @@unique([orgId, accountantEmail])
  @@map("accountant_client_links")
}

// === Ask Vela (Phase 7) ===
// Scope: a tool-calling AI assistant grounded only in existing read-only
// service/repository functions (never raw SQL, never a mutation) — RLS on
// these two tables is the standard org_isolation policy, no SECURITY
// DEFINER function needed since every read/write here already has an org
// context from the authenticated request. See the Phase 7 plan for the
// deferred scope (voice, cross-conversation memory, mutating tools).

enum AskVelaMessageRole {
  user
  assistant

  @@map("ask_vela_message_role")
}

model AskVelaConversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AskVelaMessage[]

  @@index([orgId, userId])
  @@map("ask_vela_conversations")
}

// citations: [{module, refId, label}] — the literal set of DB rows a tool
// executor touched while answering, not an LLM-invented source.
// toolCalls: [{name, input}] audit trail for debugging/testability, never
// rendered raw to the user.
model AskVelaMessage {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  role           AskVelaMessageRole
  content        String
  citations      Json?
  toolCalls      Json?              @map("tool_calls")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  organisation Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation AskVelaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, conversationId])
  @@map("ask_vela_messages")
}
