# Copy to .env.local — never commit real values (Engineering Handbook Part 8.6).
NODE_ENV=development
PORT=4000
WEB_APP_URL="http://localhost:3000"

# Postgres via Supabase (or local docker-compose Postgres for dev).
# DATABASE_URL is for `prisma migrate` only — needs owner/superuser privileges
# to create extensions, roles, and RLS policies.
DATABASE_URL="postgresql://vela:vela@localhost:5432/vela?schema=public"
# APP_DATABASE_URL is what the running API actually connects as: a plain,
# non-owner, non-superuser role (api_write_role) so RLS is genuinely enforced
# (Handbook 6.3 — Postgres never applies RLS to a table's owner or a superuser,
# regardless of policies, so using the migration role at runtime would silently
# defeat every RLS policy in the database).
APP_DATABASE_URL="postgresql://api_write_role:CHANGEME@localhost:5432/vela?schema=public"

# Redis (sessions, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT — RS256 keypair, PEM, base64-encoded single-line for env storage (Handbook 8.1)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Supabase (real project — created by the founder, see plan's external-account note)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AWS KMS (PII column encryption, wired in Epic 4 — no PII columns until PeopleHub ships)
AWS_REGION=
AWS_KMS_KEY_ID=

# Paystack (Phase 2, SmartInvoice payments) — optional; the app boots and every
# non-payment feature works without it (Handbook 1.4). Create a free Paystack
# account and use the TEST secret key (starts with sk_test_) for development.
PAYSTACK_SECRET_KEY=

# Mono (Phase 4, P&L Intelligence bank sync) — optional, same "never blocks
# anything else" contract as Paystack above. Create a free Mono sandbox
# account and use the TEST secret key for development.
MONO_SECRET_KEY=
