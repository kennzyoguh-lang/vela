NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical site URL used for metadata (OpenGraph/SEO metadataBase). Falls
# back to the current Vercel deployment URL if unset — set this to the real
# production domain (e.g. https://vela.io) once one is live.
NEXT_PUBLIC_SITE_URL=

# Mono (Phase 4, P&L Intelligence bank sync) — optional. The Money page's
# "Connect bank account" flow shows a clear "not configured" state without
# it; set the TEST public key (starts with test_pk_) once you have a Mono
# sandbox account to enable the live Connect widget.
NEXT_PUBLIC_MONO_PUBLIC_KEY=
